# Ya no hace falta editar este archivo: las claves se cargan desde la app (Configuración y CVs → Claves).
# Si preferís hacerlo a mano, copialo como ".env". NUNCA lo subas a GitHub.

# Gmail: usá una "contraseña de aplicación" (no tu contraseña normal).
# Se genera en https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
MAIL_USUARIO=tu.mail@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Solo si usás fuente = "google" en config.toml
GOOGLE_PLACES_API_KEY=
